      "properties" : {
        "Support Fragmented Transactions" : "true",
        "putsql-sql-statement" : "INSERT INTO vessel_positions (\n    mmsi, \n    ship_name, \n    region_source, \n    geom, \n    vessel_time,\n    speed_sog,\n    course_cog,\n    true_heading,\n    nav_status,\n    nav_status_desc\n)\nVALUES (\n    ${vessel.mmsi},\n    '${vessel.name.escaped}',\n    '${region.source}',\n    ST_SetSRID(ST_MakePoint(${vessel.longitude}, ${vessel.latitude}), 4326),\n    REPLACE('${vessel.time_utc}', ' UTC', '')::timestamptz,\n    NULLIF('${vessel.sog}', '')::numeric,\n    NULLIF('${vessel.cog}', '')::numeric,\n    NULLIF('${vessel.heading}', '')::integer,\n    NULLIF('${vessel.nav_status}', '')::integer,\n    CASE NULLIF('${vessel.nav_status}', '')::integer\n        WHEN 0 THEN 'Moving with engine'\n        WHEN 1 THEN 'At anchor'\n        WHEN 2 THEN 'Not under command'\n        WHEN 3 THEN 'Restricted manoeuvrability'\n        WHEN 4 THEN 'Constrained by draft'\n        WHEN 5 THEN 'Tied to dock'\n        WHEN 6 THEN 'Stuck on bottom'\n        WHEN 7 THEN 'Fishing'\n        WHEN 8 THEN 'Sailing'\n        WHEN 9 THEN 'High-speed vessel'\n        WHEN 10 THEN 'Wing-in-ground craft'\n        WHEN 11 THEN 'Towing behind'\n        WHEN 12 THEN 'Pushing ahead or alongside'\n        WHEN 13 THEN 'Saved for future use'\n        WHEN 14 THEN 'Emergency rescue active'\n        WHEN 15 THEN 'Unknown status'\n        ELSE 'Unknown status'\n    END\n);\n",
        "Batch Size" : "100",
        "Obtain Generated Keys" : "false",
        "JDBC Connection Pool" : "ca99d08a-beaf-396a-bd54-709d36ca416c",
